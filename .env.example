# Server Configuration
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Storage and Execution Mode
# Set HDFS_ENABLED=true for Mode B (Hadoop Cluster); set false for Mode A (Local Development)
HDFS_ENABLED=false
HDFS_URL=http://localhost:9870
HDFS_NAMENODE_RPC=hdfs://localhost:9000
HDFS_USER=hadoop

# Apache Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=CrimePatternAnalytics

# Machine Learning
KMEANS_N_CLUSTERS=12
RANDOM_SEED=42
